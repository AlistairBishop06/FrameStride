if(NOT DEFINED FRAMESTRIDE_TARGET)
    set(FRAMESTRIDE_TARGET aarch64)
endif()
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR "${FRAMESTRIDE_TARGET}")
set(CMAKE_TRY_COMPILE_PLATFORM_VARIABLES FRAMESTRIDE_TARGET FRAMESTRIDE_ZIG)
if(NOT FRAMESTRIDE_ZIG)
    find_program(FRAMESTRIDE_ZIG zig REQUIRED)
endif()
file(TO_CMAKE_PATH "${FRAMESTRIDE_ZIG}" FRAMESTRIDE_ZIG)
set(CMAKE_CXX_COMPILER "${FRAMESTRIDE_ZIG};c++;-target;${FRAMESTRIDE_TARGET}-linux-gnu.2.34")
set(CMAKE_AR "${FRAMESTRIDE_ZIG};ar")
set(CMAKE_RANLIB "${FRAMESTRIDE_ZIG};ranlib")
set(CMAKE_CXX_ARCHIVE_CREATE "\"${FRAMESTRIDE_ZIG}\" ar qc <TARGET> <LINK_FLAGS> <OBJECTS>")
set(CMAKE_CXX_ARCHIVE_FINISH "\"${FRAMESTRIDE_ZIG}\" ranlib <TARGET>")
set(CMAKE_CXX_ARCHIVE_APPEND "\"${FRAMESTRIDE_ZIG}\" ar q <TARGET> <LINK_FLAGS> <OBJECTS>")
