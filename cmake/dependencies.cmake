function(pinned name url hash)
    file(MAKE_DIRECTORY "${FRAMESTRIDE_DEPS}")
    set(path "${FRAMESTRIDE_DEPS}/${name}")
    if(EXISTS "${path}")
        file(SHA256 "${path}" existing)
        if(existing STREQUAL hash)
            return()
        endif()
    endif()
    file(DOWNLOAD "${url}" "${path}.download" EXPECTED_HASH "SHA256=${hash}"
         TLS_VERIFY ON TIMEOUT 60 INACTIVITY_TIMEOUT 20 STATUS result)
    list(GET result 0 code)
    if(NOT code EQUAL 0)
        message(FATAL_ERROR "Fetching ${name}: ${result}")
    endif()
    file(RENAME "${path}.download" "${path}")
endfunction()

